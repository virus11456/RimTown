{
  "manifest_version": 3,
  "name": "RimTown - AI Town Simulation",
  "version": "5.35.5",
  "description": "A RimWorld-inspired AI town simulation with day/night cycle, autonomous agents, relationships, gossip, raids, and event chains.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://api.together.xyz/*",
    "https://api.minimaxi.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_title": "RimTown"
  }
}
