{
  "manifest_version": 3,
  "name": "RimTown - AI Town Simulation",
  "version": "1.0.0",
  "description": "A RimWorld-inspired AI town simulation with autonomous agents, relationships, gossip, raids, and event chains.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://api.together.xyz/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "action": {
    "default_icon": "icons/icon48.svg",
    "default_title": "RimTown"
  }
}
