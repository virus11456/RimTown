# ===========================================
# RimTown LLM Configuration
# ===========================================
# Set LLM_PROVIDER to choose your AI backend.
# If not set, RimTown will auto-detect from available API keys.
# Options: anthropic, openai, gemini, deepseek, groq, together, ollama, mock
LLM_PROVIDER=auto

# Optional: override the default model for your provider
# LLM_MODEL=claude-sonnet-4-20250514

# Temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.8

# -------------------------------------------
# Provider API Keys (set the ones you have)
# -------------------------------------------

# Anthropic Claude (claude-sonnet, claude-opus, claude-haiku)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (gpt-4o, gpt-4o-mini, o1)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (gemini-2.0-flash, gemini-2.5-pro)
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# DeepSeek (deepseek-chat, deepseek-reasoner)
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Groq (llama-3.3-70b-versatile, mixtral-8x7b)
# https://console.groq.com/keys
GROQ_API_KEY=

# Together AI (meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo)
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# -------------------------------------------
# Ollama (local models, no API key needed)
# -------------------------------------------
# Install: https://ollama.com/
# Run: ollama pull llama3.2 && ollama serve
# OLLAMA_BASE_URL=http://localhost:11434/v1

# -------------------------------------------
# Custom OpenAI-compatible API
# -------------------------------------------
# For any other provider with OpenAI-compatible API
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://your-api.com/v1

# -------------------------------------------
# Simulation Settings
# -------------------------------------------
TICK_SPEED=2.0
AUTO_PAUSE_NIGHT=false
